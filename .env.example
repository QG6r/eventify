# Copy to .env and adjust the values if needed:
#   cp .env.example .env
POSTGRES_DB=eventify
POSTGRES_USER=eventify
POSTGRES_PASSWORD=eventify
# Secret used to sign JWT tokens: at least 32 bytes. Change it for any real deployment.
JWT_SECRET=change-me-in-env-min-32-bytes-long-secret-key
JWT_EXPIRATION_MS=86400000
BOOKING_EXPIRY_MINUTES=30
# Demo data is loaded by default in Docker Compose. Uncomment to disable it:
# FLYWAY_LOCATIONS=classpath:db/migration
