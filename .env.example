# Скопируйте в .env и при необходимости измените значения:
#   cp .env.example .env
POSTGRES_DB=eventify
POSTGRES_USER=eventify
POSTGRES_PASSWORD=change-me
# Секрет для подписи JWT: минимум 32 байта
JWT_SECRET=change-me-in-env-min-32-bytes-long-secret-key
JWT_EXPIRATION_MS=86400000
BOOKING_EXPIRY_MINUTES=30
